{
  "hosting": [
    {
      "target": "marmicode",
      "public": "dist/apps/marmicode/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "headers": [
        {
          "source": "*.*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/services",
          "destination": "/coaching",
          "type": 301
        },
        {
          "source": "/learn",
          "destination": "/library",
          "type": 301
        },
        {
          "source": "/learn/**",
          "destination": "/library",
          "type": 301
        },
        {
          "source": "/recipe/**",
          "destination": "/library",
          "type": 301
        },
        {
          "source": "/tutorial/**",
          "destination": "/library",
          "type": 301
        },
        {
          "source": "/workshops/pragmatic-angular-testing-full-course",
          "destination": "/trainings/pragmatic-angular-testing",
          "type": 301
        },
        {
          "source": "/workshops",
          "destination": "/trainings",
          "type": 301
        },
        {
          "source": "/workshops/:workshopId",
          "destination": "/trainings/:workshopId",
          "type": 301
        },
        {
          "source": "/test.ng",
          "destination": "https://courses.marmicode.io/courses/pragmatic-angular-testing?utm_source=test.ng",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "trailingSlash": false
    }
  ]
}
